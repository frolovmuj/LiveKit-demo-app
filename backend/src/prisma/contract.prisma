// use prisma-8
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  password  String?
  github_id String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Meeting {
  id        String   @id
  hostId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
}
